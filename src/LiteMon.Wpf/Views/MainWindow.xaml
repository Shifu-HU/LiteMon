<Window x:Class="LiteMon.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LiteMon.Wpf.Controls"
        Title="LiteMon — 硬件监视"
        Width="1240" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBgSolid}"
        FontFamily="{StaticResource Font.Main}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 顶栏 -->
            <RowDefinition Height="Auto"/> <!-- 导航 -->
            <RowDefinition Height="*"/>    <!-- 内容 -->
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.TopBar}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <Grid Height="52" Margin="18,6,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <Border Width="26" Height="26" CornerRadius="8"
                            Background="#263B82F6" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                        <TextBlock Text="⚡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LiteMon" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock x:Name="SubTitle" Text="…" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextSub}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 状态 Chip（CPU/GPU/RAM 含速度与显存） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ChipCpu" Style="{StaticResource Chip}" Margin="0,0,10,0">
                        <TextBlock x:Name="ChipCpuText" Text="CPU —" FontSize="11" Foreground="{DynamicResource Brush.Text}"/>
                    </Border>
                    <Border x:Name="ChipGpu" Style="{StaticResource Chip}" Background="#2EA78BFA" Margin="0,0,10,0">
                        <TextBlock x:Name="ChipGpuText" Text="GPU —" FontSize="11" Foreground="{DynamicResource Brush.Text}"/>
                    </Border>
                    <Border x:Name="ChipGpuVram" Style="{StaticResource Chip}" Background="#2EA78BFA" Margin="0,0,10,0">
                        <TextBlock x:Name="ChipGpuVramText" Text="VRAM —" FontSize="11" Foreground="{DynamicResource Brush.Text}"/>
                    </Border>
                    <Border x:Name="ChipRam" Style="{StaticResource Chip}" Background="#2E34D399">
                        <TextBlock x:Name="ChipRamText" Text="RAM —" FontSize="11" Foreground="{DynamicResource Brush.Text}"/>
                    </Border>
                </StackPanel>

                <Button x:Name="BtnPause" Grid.Column="3" Content="⏸" Style="{StaticResource BtnText}"
                        FontSize="12" Click="BtnPause_Click" ToolTip="…" Margin="10,0,0,0"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Style="{StaticResource IconBtn}" FontSize="11" Click="BtnMinimize_Click" ToolTip="…"/>
                    <Button x:Name="BtnClose" Content="✕" Style="{StaticResource IconBtn}" FontSize="11"
                            Click="BtnClose_Click" ToolTip="…"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主导航：CPU/GPU/RAM/DISK1/DISK2… + 右侧齿轮 ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.NavBar}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,8,20,8" LastChildFill="False">
                <!-- 右侧：设置齿轮（仅图标） -->
                <RadioButton x:Name="NavSettings" DockPanel.Dock="Right" Style="{StaticResource NavItem}"
                             Content="⚙" FontSize="15" Checked="Nav_Checked" Tag="Settings" GroupName="NavTabs"
                             ToolTip="…" Margin="10,0,0,0"/>

                <!-- 固定页签 -->
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="NavCpu" Style="{StaticResource NavItem}" Content="CPU" IsChecked="True" Checked="Nav_Checked" Tag="Cpu" GroupName="NavTabs" Margin="0,0,10,0"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="GPU" Checked="Nav_Checked" Tag="Gpu" GroupName="NavTabs" Margin="0,0,10,0"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="RAM" Checked="Nav_Checked" Tag="Memory" GroupName="NavTabs" Margin="0,0,10,0"/>
                    <RadioButton Style="{StaticResource NavItem}" Content="WIFI" Checked="Nav_Checked" Tag="Wifi" GroupName="NavTabs" Margin="0,0,10,0"/>
                    <RadioButton x:Name="NavDisk" Style="{StaticResource NavItem}" Content="DISK1" Checked="Nav_Checked" Tag="Disk" GroupName="NavTabs" Margin="0,0,10,0"/>
                    <!-- 可移动盘动态页签：紧跟 DISK1 之后（Disk2、Disk3…插盘出现） -->
                    <StackPanel x:Name="NavRemovableHost" Orientation="Horizontal"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Frame x:Name="Content" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal"/>
            <!-- 右下角浮岛：结束进程（页面层渲染不可靠，挂在窗口内容网格顶层） -->
            <controls:KillFab x:Name="Fab"/>
        </Grid>
    </Grid>
</Window>
